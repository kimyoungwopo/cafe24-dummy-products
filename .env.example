# 카페24 쇼핑몰 ID (예: myshop.cafe24.com 이면 myshop)
CAFE24_MALL_ID=

# 카페24 개발자센터 > 앱 > 앱 정보에서 확인
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=

# 개발자센터 앱 설정의 Redirect URI와 정확히 같아야 합니다 (https 필수)
CAFE24_REDIRECT_URI=

# 선택: 멀티쇼핑몰 번호 (기본 1)
CAFE24_SHOP_NO=1

# 선택: API 버전 (비우면 개발자센터에 설정된 앱 버전 사용)
CAFE24_API_VERSION=2026-09-01
